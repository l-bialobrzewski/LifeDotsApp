# Supabase (region: eu-central-1 / Frankfurt — patrz docs/dpia.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Szyfrowanie notatek (AES-256-GCM, klucz 32 bajty w base64) — patrz lib/encryption.ts
# Wygeneruj lokalnie: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NOTE_ENCRYPTION_KEY=

# Sentry (opcjonalnie w MVP, wymagane w devops_pipeline)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Aktualna wersja polityki prywatności / consentu (do zwiekszania przy kazdej zmianie treści)
NEXT_PUBLIC_PRIVACY_POLICY_VERSION=1.0.0

# --- Kampania wiralowa (Tydzień 0) — patrz docs/marketing/week-0-setup.md ---
# URL produkcyjny landingu (do UTM w bio)
NEXT_PUBLIC_SITE_URL=https://lifedots.app
# waitlist (domyślnie) | signup — signup dopiero po odhaczeniu beta-launch-plan sekcja 2
NEXT_PUBLIC_LANDING_MODE=waitlist
# Opcjonalnie: zewnętrzny formularz Tally gdy Supabase jeszcze niedostępny
# NEXT_PUBLIC_EXTERNAL_WAITLIST_URL=https://tally.so/r/XXXXXX
# Anonimowa ankieta WTP — link po zapisie na waitlistę (Tally / Google Forms)
# NEXT_PUBLIC_WTP_SURVEY_URL=https://tally.so/r/YYYYYY
